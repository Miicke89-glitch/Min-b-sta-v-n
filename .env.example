# Kopiera till .env.local och fyll i från Supabase-projektets inställningar
# (Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://ditt-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-nyckel

# Behövs endast för seedscriptet (npm run seed). Dela aldrig denna nyckel.
SUPABASE_SERVICE_ROLE_KEY=din-service-role-nyckel

# Appens publika URL (används i inbjudningslänkar). Lokalt:
NEXT_PUBLIC_APP_URL=http://localhost:3000
